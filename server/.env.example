PORT=5000
NODE_ENV=development

# AWS Configuration (Leave blank or set AWS_MOCK=true to run in local mock mode)
AWS_MOCK=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# AWS Resource Names
DYNAMODB_INVENTORY_TABLE=multipurpose-scm-inventory-dev
DYNAMODB_ORDERS_TABLE=multipurpose-scm-orders-dev
DYNAMODB_SHIPMENTS_TABLE=multipurpose-scm-shipments-dev
DYNAMODB_SUPPLIERS_TABLE=multipurpose-scm-suppliers-dev
DYNAMODB_TELEMETRY_TABLE=multipurpose-scm-iot-telemetry-dev

S3_DOCUMENTS_BUCKET=multipurpose-scm-docs-dev-us-east-1
SQS_ORDERS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/multipurpose-scm-orders-queue-dev
SNS_ALERTS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:multipurpose-scm-alerts-topic-dev
